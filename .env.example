PORT=8080
ENV=development
SERVICE_NAME=herald
LOG_LEVEL=info

READ_TIMEOUT=15s
WRITE_TIMEOUT=15s
IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
MAX_BODY_BYTES=1048576

# Origins of the product PWAs that call the public registration endpoint.
CORS_ALLOWED_ORIGINS=http://localhost:9000

# Private control plane. Generate the Argon2id hash with:
# read -rs ADMIN_PASSWORD_INPUT; printf '\n'; printf '%s\n' "$ADMIN_PASSWORD_INPUT" | go run ./cmd/heraldctl hash-password; unset ADMIN_PASSWORD_INPUT
ADMIN_ORIGIN=http://localhost:5173
ADMIN_USERNAME=
# In Compose env files, single-quote the hash so its $ characters stay literal.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_TTL=8h
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_WINDOW=15m

# Remote PostgreSQL connection. Production should require TLS.
# Development only; replace for production. Compose supplies its own DB host.
POSTGRES_PASSWORD=development-only
DATABASE_URL=postgres://herald:development-only@localhost:5433/herald?sslmode=disable
DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m

# Base64 encoded 32 byte key protecting VAPID private keys at rest.
# Generate with: go run ./cmd/heraldctl keygen
# Web Push is disabled while this is empty. Rotation: docs/operations.md
ENCRYPTION_KEY=
ENCRYPTION_KEYS_RETIRED=

WEBPUSH_DISPATCH_INTERVAL=2s
WEBPUSH_BATCH_SIZE=50
WEBPUSH_LEASE=30s
WEBPUSH_MAX_ATTEMPTS=5

# Firebase Cloud Messaging for native Android delivery. Authentication uses
# Application Default Credentials; on a VM set GOOGLE_APPLICATION_CREDENTIALS
# to the mounted service-account JSON path.
FCM_PROJECT_ID=
# Either use a local GOOGLE_APPLICATION_CREDENTIALS file, or load this private
# object from the S3-compatible bucket configured below.
GOOGLE_APPLICATION_CREDENTIALS=
FCM_CREDENTIALS_OBJECT=firebase-svc-acc-private-key.json
FCM_DISPATCH_INTERVAL=2s
FCM_BATCH_SIZE=50
FCM_LEASE=30s
FCM_MAX_ATTEMPTS=5
EXPIRY_SWEEP_INTERVAL=1m

OBJECT_STORAGE_PROVIDER=
S3_ENDPOINT=
S3_BUCKET=
AWS_DEFAULT_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
